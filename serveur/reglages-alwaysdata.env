# Réglages du serveur des avis en ligne (alwaysdata). Rien de secret ici.
# Copié en ligne sous le nom reglages.env par deployer.sh.

# le site est à l'adresse https://chrysalide.alwaysdata.net/natx
NATX_PREFIXE=/natx
# seul le jeu publié sur GitHub Pages peut envoyer des avis et voter
NATX_ORIGINES=https://natxmans.github.io
# le site est en HTTPS : cookie admin « Secure »
NATX_HTTPS=1
# alwaysdata met déjà la vraie adresse du joueur dans REMOTE_ADDR (uWSGI la prend dans X-Real-IP).
# Son X-Forwarded-For, lui, garde ce que le visiteur invente (vérifié le 8 nov. 2026) : ne PAS l'utiliser.
NATX_PROXY=0
